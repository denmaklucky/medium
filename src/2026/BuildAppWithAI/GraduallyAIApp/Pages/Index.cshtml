@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-5">
    <h1 class="display-4">Welcome to ToDo List</h1>
    <p class="lead text-muted">A simple, focused task manager.</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-page="/Todos" class="btn btn-primary btn-lg mt-3">Go to My Todos</a>
    }
    else
    {
        <div class="mt-3">
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary btn-lg me-2">Login</a>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-primary btn-lg">Register</a>
        </div>
    }
</div>

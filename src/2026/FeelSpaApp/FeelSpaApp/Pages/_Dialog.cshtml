@model List<FeelSpaApp.Pages.Dialog.Product>

<dialog x-data="{
            ratio: 0.5,
            viewportWidth: window.innerWidth,
            viewportHeight: window.innerHeight,
            get width() { return this.viewportWidth * this.ratio },
            get height() { return this.viewportHeight * this.ratio }
        }"
        x-init="$el.showModal()"
        x-bind:style="{ width: width + 'px', height: height + 'px' }"
        x-on:resize.window="viewportWidth = window.innerWidth; viewportHeight = window.innerHeight"
        x-on:close="$el.remove()">
    <div class="box">
        <h2 class="title is-4">Products</h2>

        <table class="table is-fullwidth is-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>@product.Id</td>
                        <td>@product.Name</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="buttons is-right">
            <button type="button"
                    class="button is-light"
                    x-on:click="ratio = ratio === 0.5 ? 0.8 : 0.5"
                    x-text="ratio === 0.5 ? 'Expand to 80%' : 'Shrink to 50%'">
            </button>
            <button type="button" class="button" x-on:click="$root.close()">Close</button>
        </div>
    </div>
</dialog>

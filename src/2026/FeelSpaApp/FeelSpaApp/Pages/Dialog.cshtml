@page

@model FeelSpaApp.Pages.Dialog

@{
    ViewData["Title"] = "Dialog";
}

<h1 class="title is-3">Open a dialog to see product</h1>

<div class="has-text-centered">
    <button type="button"
            class="button is-primary"
            hx-get="@Url.Page("Dialog", "Dialog")"
            hx-target="#dialog"
            hx-swap="innerHTML">
        Open dialog
    </button>
</div>

<div id="dialog"></div>

@page

@model FeelSpaApp.Pages.Notification

@{
    ViewData["Title"] = "Notification";
}

<h1 class="title is-3">Notification</h1>

<div class="has-text-centered">
    <button type="button"
            class="button is-primary"
            hx-get="@Url.Page("Notification", "Notification")"
            hx-target="#notification"
            hx-swap="innerHTML">
        Show notification
    </button>
</div>

<div id="notification" class="mt-4"></div>

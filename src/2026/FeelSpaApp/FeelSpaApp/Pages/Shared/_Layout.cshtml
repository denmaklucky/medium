<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FeelSpaApp</title>
    <script type="importmap"></script>
    <script src="~/scripts/htmx.min.js" asp-append-version="true"></script>
    <script src="~/scripts/alpine.min.js" asp-append-version="true" defer></script>
    <link rel="stylesheet" href="css/bulma.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FeelSpaApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar is-white border-bottom box-shadow mb-3" role="navigation" aria-label="main navigation">
            <div class="container">
                <div class="navbar-brand">
                    <a class="navbar-item" asp-area="" asp-page="/Index">FeelSpaApp</a>
                    <a class="navbar-burger" role="button" data-target="navbarMain" aria-controls="navbarMain"
                       aria-expanded="false" aria-label="Toggle navigation">
                        <span aria-hidden="true"></span>
                        <span aria-hidden="true"></span>
                        <span aria-hidden="true"></span>
                    </a>
                </div>
                <div id="navbarMain" class="navbar-menu">
                    <div class="navbar-start">
                        <a class="navbar-item has-text-dark" asp-area="" asp-page="/Index">Home</a>
                        <a class="navbar-item has-text-dark" asp-area="" asp-page="/BulkActions">Bulk Actions</a>
                        <a class="navbar-item has-text-dark" asp-area="" asp-page="/ContextMenu">Context Menu</a>
                        <a class="navbar-item has-text-dark" asp-area="" asp-page="/Dialog">Dialog</a>
                        <a class="navbar-item has-text-dark" asp-area="" asp-page="/SelectFilter">Select Filter</a>
                        <a class="navbar-item has-text-dark" asp-area="" asp-page="/Notification">Notification</a>
                        <a class="navbar-item has-text-dark" asp-area="" asp-page="/FloatButton">Float Button</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer has-text-grey">
        <div class="container">
            &copy; 2026 - FeelSpaApp
        </div>
    </footer>
</body>
</html>
